    { date: '10월 24일 (토) 9:00', name: '토요 문화학교' },
    { date: '10월 25일 (주일) 11:20', name: '친구초청주일 2' }
  ],
  gift: '세 번의 만남에 모두 함께한 친구들에게\n특별한 선물을 준비했어요.\n우리 세 번 다 만나요!',
  place: '서울숲교회 큰꿈나무교회',
  timeNote: '함께 만나요!',
  mapUrl: ''
};
const DURATION=30, MAX_HITS=5, $=id=>document.getElementById(id), canvas=$('game'), ctx=canvas.getContext('2d');
let W=900,H=410,ground=330,mode='ready',elapsed=0,last=0,y=0,vy=0,score=0,hits=0,obstacles=[],stars=[],nextObstacle=3,nextStar=2,invincible=0,friend=false,toastUntil=0,sound=false,audioCtx;
function resize(){const r=canvas.getBoundingClientRect();W=r.width;H=r.height;ground=H-69;const d=Math.min(devicePixelRatio||1,2);canvas.width=W*d;canvas.height=H*d;ctx.setTransform(d,0,0,d,0,0)}
addEventListener('resize',resize);resize();
function round(x,y,w,h,r,c){ctx.fillStyle=c;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}
function ellipse(x,y,rx,ry,c){ctx.fillStyle=c;ctx.beginPath();ctx.ellipse(x,y,rx,ry,0,0,Math.PI*2);ctx.fill()}
function line(x,y,xx,yy,c,width=4){ctx.strokeStyle=c;ctx.lineWidth=width;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(xx,yy);ctx.stroke()}
function person(x,foot,color,t,small=false){ctx.save();ctx.translate(x,foot);if(small)ctx.scale(.88,.88);const swing=mode==='running'&&y===0?Math.sin(t*14)*7:0;ellipse(0,-2,19,5,'#28473520');line(-7,-16,-9+swing,0,'#334d43',7);line(7,-16,9-swing,0,'#334d43',7);round(-16,-46,32,32,11,color);line(-17,-38,-23-swing*.6,-24,'#edb888',7);line(17,-38,23+swing*.6,-26,'#edb888',7);ellipse(0,-61,20,22,'#f5c59c');ellipse(0,-74,20,12,'#4c4237');ellipse(-15,-66,6,10,'#4c4237');ellipse(-6,-61,1.7,2,'#34493e');ellipse(7,-61,1.7,2,'#34493e');ctx.strokeStyle='#aa654f';ctx.lineWidth=2;ctx.beginPath();ctx.arc(1,-55,5,0,Math.PI);ctx.stroke();round(6,-39,16,12,2,'#fff9e6');line(7,-38,14,-33,'#d4b67b',1);line(14,-33,21,-38,'#d4b67b',1);ctx.restore()}
function star(x,y,r=10){ctx.fillStyle='#edb63c';ctx.beginPath();for(let i=0;i<10;i++){const a=-Math.PI/2+i*Math.PI/5,k=i%2?r*.46:r;ctx.lineTo(x+Math.cos(a)*k,y+Math.sin(a)*k)}ctx.closePath();ctx.fill()}
function draw(){ctx.clearRect(0,0,W,H);ctx.fillStyle='#dceee3';ctx.fillRect(0,0,W,H);ellipse(W*.8,87,31,31,'#fff0b0');for(let i=0;i<4;i++){let x=((i*230-elapsed*8)%(W+230)+W+230)%(W+230)-60;ellipse(x,98+i%2*35,37,10,'#f8fcf2');ellipse(x+17,90+i%2*35,23,16,'#f8fcf2')}
for(let i=0;i<5;i++)ellipse(i*W/3-50,ground+20,W*.35,100+i%2*30,'#b6d6b4');for(let i=0;i<5;i++){let x=((i*230-elapsed*22)%(W+230)+W+230)%(W+230);round(x-4,ground-85,8,87,3,'#a4b588');ellipse(x,ground-92,29,44,'#8fb68d');ellipse(x+17,ground-70,22,31,'#98bd91')}
ctx.fillStyle='#d4ddb0';ctx.fillRect(0,ground,W,H-ground);ctx.fillStyle='#f0dfb9';ctx.fillRect(0,ground+11,W,42);for(let i=0;i<16;i++){let x=((i*80-elapsed*150)%(W+80)+W+80)%(W+80);round(x,ground+30,15,3,2,'#d3c29c')}
if(elapsed>DURATION-6){const x=W+80-(elapsed-(DURATION-6))/6*(W-170);round(x,ground-95,105,95,7,'#fff8de');ctx.fillStyle='#d0835f';ctx.beginPath();ctx.moveTo(x-12,ground-92);ctx.lineTo(x+52,ground-139);ctx.lineTo(x+117,ground-92);ctx.fill();round(x+43,ground-49,24,49,12,'#89ad88');line(x+52,ground-130,x+52,ground-110,'#fff4d9',4);line(x+45,ground-123,x+59,ground-123,'#fff4d9',4)}
for(const o of obstacles){if(o.type===0){ellipse(o.x+o.w/2,ground-3,o.w/2,7,'#82bfcc');ellipse(o.x+o.w/2,ground-4,o.w/3,2,'#c5e4e5')}else{round(o.x,ground-o.h,o.w,o.h,7,'#bfa27a');round(o.x+5,ground-o.h+5,o.w-10,5,2,'#d5bd97')}}for(const s of stars)star(s.x,s.y,11);
const px=W*.25; if(friend)person(px-44,ground-y*.85,'#e7ab51',elapsed+.4,true);if(invincible<=0||Math.floor(invincible*12)%2===0)person(px,ground-y,'#659dc1',elapsed);
}
function beep(freq){if(!sound)return;try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();audioCtx.resume();const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.value=freq;o.connect(g);g.connect(audioCtx.destination);g.gain.setValueAtTime(.07,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(.001,audioCtx.currentTime+.13);o.start();o.stop(audioCtx.currentTime+.14)}catch(e){}}
function toast(text,time=2){$('hint').firstElementChild.textContent=text;$('hint').classList.remove('hidden');toastUntil=elapsed+time}
function hud(){$('score').textContent=score;$('livesCount').textContent=MAX_HITS-hits;$('lives').setAttribute('aria-label',`남은 기회 ${MAX_HITS-hits}번`);$('lives').classList.toggle('low',hits>=3);const progress=Math.min(100,elapsed/DURATION*100);$('fill').style.width=progress+'%';document.querySelector('.track').setAttribute('aria-valuenow',Math.round(progress))}
function start(){mode='running';elapsed=0;y=0;vy=0;score=0;hits=0;obstacles=[];stars=[];nextObstacle=3;nextStar=2;invincible=0;friend=false;$('overlay').classList.add('hidden');$('pause').textContent='Ⅱ';$('pause').setAttribute('aria-label','일시 정지');hud();toast('화면을 톡! 누르면 점프해요',4)}
function fail(){mode='lost';hud();$('hint').classList.add('hidden');$('panelTitle').textContent='한 번 더 도전해 볼까?';$('panelText').textContent=`${Math.floor(elapsed/DURATION*100)}%까지 왔어요! 별 ${score}개를 모았네요. 기회 5번으로 처음부터 다시 도전해요.`;$('start').textContent='다시 도전하기 →';$('overlay').classList.remove('hidden')}
function jump(){if(mode==='running'&&y===0){vy=590;beep(470)}}
function pause(){if(mode!=='running')return;mode='paused';$('panelTitle').textContent='잠깐 쉬어가요';$('panelText').textContent='준비되면 이어서 달려요!';$('start').textContent='계속하기 →';$('overlay').classList.remove('hidden')}
function openInvite(won=false){if(mode==='running')pause();$('result').textContent=won?`도착 성공! 별 ${score}개를 모았어요 ⭐`:'너에게 온 특별한 초대장';$('invitation').showModal()}
function tick(now){const dt=Math.min((now-last)/1000||0,.04);last=now;if(mode==='running'){elapsed+=dt;vy-=1600*dt;y=Math.max(0,y+vy*dt);if(y===0)vy=0;invincible=Math.max(0,invincible-dt);const speed=Math.max(165,Math.min(255,W*.47));if(elapsed>nextObstacle&&elapsed<DURATION-4){const type=Math.random()<.35?0:1;obstacles.push({x:W+30,w:type===0?43:29,h:type===0?10:30,type});nextObstacle=elapsed+1.8+Math.random()*.8}if(elapsed>nextStar&&elapsed<DURATION-3){stars.push({x:W+20,y:ground-90});nextStar=elapsed+1.05+Math.random()*.8}const px=W*.25;for(const o of obstacles){o.x-=speed*dt;if(!o.hit&&invincible===0&&px+12>o.x&&px-12<o.x+o.w&&y<o.h-3){o.hit=true;invincible=1;hits++;beep(180);if(hits>=MAX_HITS){fail();break}toast(hits===4?'마지막 기회! 조금만 더 집중해요':`앗! 남은 기회 ${MAX_HITS-hits}번. 다시 폴짝!`)}}if(mode==='lost'){draw();requestAnimationFrame(tick);return}for(const s of stars){s.x-=speed*dt;if(!s.got&&Math.abs(s.x-px)<25&&Math.abs(s.y-(ground-y-45))<43){s.got=true;score++;beep(800)}}obstacles=obstacles.filter(o=>o.x>-60);stars=stars.filter(s=>s.x>-30&&!s.got);if(!friend&&elapsed>=DURATION/2){friend=true;toast('친구를 만났어요! 이제 함께 가요 💛',3);beep(660)}if(elapsed>toastUntil)$('hint').classList.add('hidden');hud();if(elapsed>=DURATION){elapsed=DURATION;mode='won';hud();beep(950);openInvite(true)}}draw();requestAnimationFrame(tick)}
$('start').onclick=()=>{if(mode==='paused'){mode='running';$('overlay').classList.add('hidden')}else start()};$('pause').onclick=pause;$('jump').onclick=jump;canvas.addEventListener('pointerdown',e=>{e.preventDefault();jump()});addEventListener('keydown',e=>{if((e.code==='Space'||e.code==='ArrowUp')&&!$('invitation').open&&e.target.tagName!=='BUTTON'&&e.target.tagName!=='A'){e.preventDefault();jump()}});document.addEventListener('visibilitychange',()=>{if(document.hidden)pause()});$('direct').onclick=()=>openInvite();$('close').onclick=()=>$('invitation').close();$('replay').onclick=()=>{$('invitation').close();start()};$('sound').onclick=()=>{sound=!sound;$('sound').textContent=sound?'소리 끄기':'소리 켜기';$('sound').setAttribute('aria-pressed',sound);beep(600)};
$('inviteTitle').textContent=EVENT.title;
$('message').textContent=EVENT.message;
$('schedule').innerHTML=EVENT.schedule.map((event,i)=>`<div class="event-row"><span class="event-number">${i+1}</span><div class="event-copy"><span class="event-date">${event.date}</span><strong class="event-name">${event.name}</strong></div></div>`).join('');
$('giftMessage').textContent=EVENT.gift;
$('details').textContent=`2026년 10월 · ${EVENT.place}\n${EVENT.timeNote}`;
if(/^https?:\/\//.test(EVENT.mapUrl)){$('map').href=EVENT.mapUrl;$('map').classList.remove('hidden')}
// 화면 초대장과 저장 이미지가 같은 행사 정보를 사용합니다.
$('save').onclick=()=>{
  const c=document.createElement('canvas');c.width=900;c.height=1500;
  const g=c.getContext('2d');
  function box(x,y,w,h,r,color){g.fillStyle=color;g.beginPath();g.roundRect(x,y,w,h,r);g.fill()}
  function label(text,x,y,size=28,color='#285d40',bold=false){g.fillStyle=color;g.font=`${bold?'bold ':''}${size}px sans-serif`;g.fillText(text,x,y)}
  // 공백 단위로 줄을 나누어 한글 단어가 중간에서 잘리지 않게 합니다.
  function paragraph(text,y,size=28,width=740){g.font=`${size}px sans-serif`;for(const line of text.split('\n')){if(!line){y+=size*.7;continue}let row='';for(const word of line.split(' ')){const candidate=row?row+' '+word:word;if(row&&g.measureText(candidate).width>width){label(row,450,y,size);y+=size*1.5;row=word}else row=candidate}label(row,450,y,size);y+=size*1.5}return y}
  g.fillStyle='#fff9e9';g.fillRect(0,0,c.width,c.height);
